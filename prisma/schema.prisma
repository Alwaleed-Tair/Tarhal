generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  role     String    @default("traveler")
  bookings Booking[]
}

model Flight {
  id            String    @id @default(uuid())
  flightNumber  String    @unique
  from          String
  to            String
  departureTime DateTime
  arrivalTime   DateTime
  basePrice     Float
  seats         Seat[]
  bookings      Booking[]
}

model Seat {
  id              String            @id @default(uuid())
  flightId        String
  flight          Flight            @relation(fields: [flightId], references: [id])
  seatCode        String
  ticketClass     String
  priceMultiplier Float             @default(1.0)
  status          SeatStatus        @default(AVAILABLE)
  traveler        BookingTraveler?

  @@unique([flightId, seatCode])
}

model Booking {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  flightId      String
  flight        Flight            @relation(fields: [flightId], references: [id])
  basePrice     Float
  luggageFee    Float             @default(0)
  discount      Float             @default(0)
  totalPrice    Float
  paymentStatus PaymentStatus     @default(PENDING)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  travelers     BookingTraveler[]
}

model BookingTraveler {
  id             String   @id @default(uuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id])
  seatId         String   @unique
  seat           Seat     @relation(fields: [seatId], references: [id])
  fullName       String
  passportNumber String
  dateOfBirth    DateTime
}

// Mohammed Alasad's MVP catalog: fictional seed data, no live availability.
model Hotel {
  id            String  @id @default(uuid())
  name          String
  city          String
  pricePerNight Decimal @db.Decimal(10, 2) // SAR for the listed room type.
  rating        Float // Sample rating on a 1–5 scale.
  roomType      String // One representative room type per sample hotel.
}

model Car {
  id              String  @id @default(uuid())
  category        String
  pricePerDay     Decimal @db.Decimal(10, 2) // SAR, excluding optional insurance.
  insuranceOption Boolean // Whether optional insurance is offered.
}