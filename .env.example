# AI chat (DeepSeek). Server-side only; set the same name in Netlify env vars.
DEEPSEEK_API_KEY=
# Optional: TARHAL_MODEL_FLASH=deepseek-flash
# Web search for the chat (DeepSeek server-side search, same key). Default on; set false to disable.
# Slower, deeper reasoning (off by default for speed): TARHAL_THINKING=true
# TARHAL_WEB_SEARCH=true
# TARHAL_SEARCH_MAX_USES=2
# TARHAL_SEARCH_TIMEOUT_MS=15000
# PostgreSQL connection for the application. Never use production for tests.
DATABASE_URL="postgresql://postgres:password@localhost:5432/tarhal?schema=public"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PASSWORD_RESET_SECRET=
# Set to the actual monitored support inbox; recovery returns 503 until configured.
PASSWORD_RESET_SUPPORT_EMAIL=
# Optional: dedicated local test database, never a production database.
TEST_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/tarhal_test"

# Signed session cookie secret: at least 32 random bytes. Never commit a real value (generate it like PASSWORD_RESET_SECRET above).
SESSION_SECRET=
